! Finite-Er refinement of high.input.namelist.

&general
  RHSMode = 1
/

&geometryParameters
  inputRadialCoordinate = 3
  rN_wish = 0.3
  geometryScheme = 1
  B0OverBBar = 1.0d+0
  GHat = 1.0d+0
  IHat = 0.0d+0
  iota = 1.31d+0
  epsilon_t = 0.1d+0
  epsilon_h = 0.0d+0
  helicity_l = 1
  helicity_n = 1
  psiAHat = 0.045d+0
  aHat = 0.1
/

&speciesParameters
  Zs = 1
  mHats = 1
  nHats = 1.0d+0
  THats = 0.5d+0
  dNHatdrHats = -6.0d+0
  dTHatdrHats = -3.0d+0
/

&physicsParameters
  Delta = 4.5694d-3
  alpha = 1.0d+0
  nu_n = 8.4774d-3
  Er = -30.0d+0
  collisionOperator = 0
  includeXDotTerm = .true.
  includeElectricFieldTermInXiDot = .true.
  useDKESExBDrift = .false.
  includePhi1 = .false.
  constraintScheme = -1
/

&resolutionParameters
  Ntheta = 33
  Nzeta = 1
  Nxi = 47
  Nx = 12
  NL = 4
  solverTolerance = 1d-13
/

&otherNumericalParameters
/

&preconditionerOptions
  preconditioner_x = 0
/

&export_f
/
